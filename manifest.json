{
  "runtime": "canvas-v1",
  "name": "Drift",
  "description": "Des nuages doux qui traversent lentement un ciel profond.",
  "version": "0.1.0",
  "entry": "dist/assets/addon.js",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "1",
  "ui": {
    "pointerEvents": "none"
  },
  "settings": [
    {
      "id": "sky",
      "type": "color",
      "label": "Ciel",
      "default": "#152831"
    },
    {
      "id": "cloud",
      "type": "color",
      "label": "Nuages",
      "default": "#97aaa9"
    },
    {
      "id": "coverage",
      "type": "range",
      "label": "Couverture (%)",
      "default": 45,
      "min": 10,
      "max": 90,
      "step": 1
    },
    {
      "id": "speed",
      "type": "range",
      "label": "Vitesse",
      "default": 1,
      "min": 0.1,
      "max": 3,
      "step": 0.1
    },
    {
      "id": "motion",
      "type": "boolean",
      "label": "Animation",
      "default": true
    }
  ]
}
